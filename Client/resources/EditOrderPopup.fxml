<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.EditOrderPopup">
   <children>
      <HBox alignment="TOP_CENTER" prefHeight="358.0" prefWidth="580.0" spacing="10.0">
         <children>
            <VBox alignment="TOP_CENTER" prefHeight="297.0" prefWidth="124.0" spacing="10.0">
               <children>
                  <VBox alignment="CENTER" spacing="5.0" />
                  <ComboBox fx:id="selectedSupplier" prefWidth="150.0" promptText="Supplier" />
               </children>
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="200.0" />
            <TableView fx:id="productTable" editable="true" prefHeight="341.0" prefWidth="298.0">
              <columns>
                <TableColumn prefWidth="304.5" text="Product" />
                <TableColumn prefWidth="71.5" text="Count" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <VBox alignment="TOP_CENTER" spacing="10.0">
               <children>
                  <ComboBox fx:id="selectedProduct" prefWidth="150.0" promptText="Product" />
                  <VBox alignment="TOP_CENTER" spacing="5.0">
                     <children>
                        <Label text="Count" />
                        <TextField fx:id="productCount" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER" spacing="20.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onAddProductPressed" prefWidth="59.0" text="Add" />
                        <Button mnemonicParsing="false" onAction="#onRemovePressed" prefWidth="59.0" text="Remove" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <VBox.margin>
            <Insets left="10.0" right="10.0" />
         </VBox.margin>
      </HBox>
      <Label fx:id="errorMessageField" textFill="RED" />
      <HBox alignment="CENTER" prefHeight="63.0" prefWidth="600.0" spacing="100.0">
         <children>
            <Button cancelButton="true" mnemonicParsing="false" onAction="#onCancelPressed" text="Cancel" />
            <Button defaultButton="true" mnemonicParsing="false" onAction="#onConfirmPressed" text="Confirm" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="15.0" top="20.0" />
   </padding>
</VBox>
