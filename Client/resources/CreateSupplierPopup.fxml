<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" fillWidth="false" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.CreateSupplierPopup">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="315.0" prefWidth="330.0" spacing="10.0">
         <children>
            <VBox alignment="CENTER" fillWidth="false" spacing="5.0">
               <children>
                  <Label text="Associated user" />
                  <ComboBox fx:id="selectedUser" prefWidth="150.0" promptText="User" />
               </children>
            </VBox>
            <VBox alignment="CENTER" fillWidth="false" spacing="5.0">
               <children>
                  <Label text="Name" />
                  <TextField fx:id="inputName" />
               </children>
            </VBox>
            <VBox alignment="CENTER" fillWidth="false" spacing="5.0">
               <children>
                  <Label text="Description" />
                  <TextArea fx:id="inputDescription" prefHeight="105.0" prefWidth="153.0" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets top="25.0" />
         </padding>
      </VBox>
      <Label fx:id="errorMessageField" textFill="RED" />
      <FlowPane alignment="CENTER" hgap="150.0" prefHeight="78.0" prefWidth="600.0">
         <children>
            <Button cancelButton="true" mnemonicParsing="false" onAction="#onCancelPressed" text="Cancel">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#onConfirmPressed" text="Confirm">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
         </children>
      </FlowPane>
   </children>
</VBox>
