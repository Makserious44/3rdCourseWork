<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.Register">
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Store stocker" textOrigin="CENTER">
         <font>
            <Font name="VT323 Regular" size="36.0" />
         </font>
      </Text>
      <VBox alignment="CENTER" fillWidth="false">
         <children>
            <Pane prefHeight="213.0" prefWidth="521.0">
               <children>
                  <FlowPane layoutY="14.0" prefHeight="122.0" prefWidth="156.0">
                     <children>
                        <Pane prefHeight="61.0" prefWidth="149.0">
                           <children>
                              <Label layoutX="57.0" layoutY="14.0" text="Login" textAlignment="CENTER">
                                 <font>
                                    <Font name="VT323 Regular" size="18.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="inputLogin" layoutX="1.0" layoutY="35.0" />
                           </children>
                        </Pane>
                        <Pane prefHeight="61.0" prefWidth="149.0">
                           <children>
                              <PasswordField fx:id="inputPassword" layoutY="31.0" />
                              <Label alignment="CENTER" contentDisplay="CENTER" layoutX="45.0" layoutY="14.0" text="Password" textAlignment="CENTER">
                                 <font>
                                    <Font name="VT323 Regular" size="18.0" />
                                 </font>
                              </Label>
                           </children>
                        </Pane>
                        <Pane prefHeight="61.0" prefWidth="149.0">
                           <children>
                              <PasswordField fx:id="repeatPassword" layoutY="31.0" />
                              <Label layoutX="20.0" layoutY="14.0" text="Repeat Password" textAlignment="CENTER">
                                 <font>
                                    <Font name="VT323 Regular" size="18.0" />
                                 </font>
                              </Label>
                           </children>
                        </Pane>
                     </children>
                  </FlowPane>
                  <FlowPane hgap="20.0" layoutX="198.0" layoutY="14.0" prefHeight="195.0" prefWidth="323.0">
                     <children>
                        <Pane prefHeight="61.0" prefWidth="149.0">
                           <children>
                              <Label layoutX="39.0" layoutY="14.0" text="First name" textAlignment="CENTER">
                                 <font>
                                    <Font name="VT323 Regular" size="18.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="firstName" layoutX="1.0" layoutY="35.0" />
                           </children>
                        </Pane>
                        <Pane prefHeight="61.0" prefWidth="149.0">
                           <children>
                              <Label layoutX="42.0" layoutY="14.0" text="Last name" textAlignment="CENTER">
                                 <font>
                                    <Font name="VT323 Regular" size="18.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="lastName" layoutX="1.0" layoutY="35.0" />
                           </children>
                        </Pane>
                        <Pane prefHeight="61.0" prefWidth="149.0">
                           <children>
                              <Label layoutX="61.0" layoutY="14.0" text="Mail" textAlignment="CENTER">
                                 <font>
                                    <Font name="VT323 Regular" size="18.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="mail" layoutX="1.0" layoutY="35.0" />
                           </children>
                        </Pane>
                        <Pane prefHeight="61.0" prefWidth="149.0">
                           <children>
                              <Label layoutX="57.0" layoutY="14.0" text="Phone" textAlignment="CENTER">
                                 <font>
                                    <Font name="VT323 Regular" size="18.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="phone" layoutX="1.0" layoutY="35.0" />
                           </children>
                        </Pane>
                        <Pane prefHeight="61.0" prefWidth="149.0">
                           <children>
                              <Label layoutX="50.0" layoutY="14.0" text="Address" textAlignment="CENTER">
                                 <font>
                                    <Font name="VT323 Regular" size="18.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="address" layoutX="1.0" layoutY="35.0" />
                           </children>
                        </Pane>
                     </children>
                  </FlowPane>
                  <Line endX="5.5" endY="172.0" layoutX="170.0" layoutY="23.0" startX="5.5" startY="19.0" stroke="#000000c3" />
               </children>
            </Pane>
         </children>
      </VBox>
      <Label fx:id="errorMessageField" alignment="CENTER" contentDisplay="CENTER" prefHeight="20.0" prefWidth="347.0" textAlignment="CENTER" textFill="RED">
         <font>
            <Font name="VT323 Regular" size="18.0" />
         </font>
      </Label>
      <FlowPane alignment="CENTER" hgap="70.0" vgap="30.0">
         <children>
            <Button cancelButton="true" mnemonicParsing="false" onAction="#cancelPressed" prefHeight="25.0" prefWidth="92.0" text="Cancel">
               <font>
                  <Font name="VT323 Regular" size="14.0" />
               </font></Button>
            <Button fx:id="buttonRegister" defaultButton="true" mnemonicParsing="false" onAction="#registerPressed" prefHeight="25.0" prefWidth="92.0" text="Register">
               <font>
                  <Font name="VT323 Regular" size="14.0" />
               </font></Button>
         </children>
      </FlowPane>
   </children>
   <padding>
      <Insets bottom="30.0" left="60.0" right="60.0" top="40.0" />
   </padding>
</VBox>
